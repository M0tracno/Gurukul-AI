# ===========================================================================
# GURUKUL AI FRONTEND — Environment Configuration
# ===========================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env to version control.
#
# Vite exposes variables prefixed with VITE_ to the client bundle.
# ---------------------------------------------------------------------------

# ─── App Configuration ──────────────────────────────────────────────────────────
# Base URL of the backend API server
VITE_API_URL=http://localhost:5000

# WebSocket URL for real-time features (Socket.IO)
VITE_SOCKET_URL=ws://localhost:5000

# Application display name
VITE_APP_NAME=Gurukul AI

# Application version (used in Sentry releases)
VITE_APP_VERSION=1.0.0

# ─── AI Services ────────────────────────────────────────────────────────────────
# NOTE: These are transitional. AI keys will move to backend-only in production.
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_VERTEX_API_KEY=your-vertex-api-key
VITE_GCP_PROJECT_ID=your-gcp-project-id

# ─── Error Reporting (Sentry) ───────────────────────────────────────────────────
# Get your DSN from: https://sentry.io → Settings → Projects → Client Keys
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ─── Feature Flags ──────────────────────────────────────────────────────────────
# Use mock services for local development without API
VITE_USE_MOCK_SERVICES=false

# Enable verbose console logging in development
VITE_ENABLE_LOGGING=true

# Enable debug mode (extra DevTools panels, network inspector)
VITE_DEBUG_MODE=false
