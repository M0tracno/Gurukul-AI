{
  "name": "gurukul-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Gurukul AI — Bridging traditional education with modern technology",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pbt": "vitest run property",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --config tests/visual-regression/playwright.visual.config.ts",
    "test:visual:update": "playwright test --config tests/visual-regression/playwright.visual.config.ts --update-snapshots",
    "prepare": "husky install"
  },
  "dependencies": {
    "@date-io/date-fns": "3.2.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@google/generative-ai": "0.24.1",
    "@mui/icons-material": "7.1.1",
    "@mui/lab": "7.0.0-beta.13",
    "@mui/material": "7.1.1",
    "@mui/system": "7.1.1",
    "@mui/x-date-pickers": "8.5.0",
    "@mui/x-date-pickers-pro": "8.5.0",
    "@sentry/react": "9.27.0",
    "@tanstack/react-query": "5.80.7",
    "@types/crypto-js": "4.2.2",
    "@types/qrcode": "1.5.5",
    "ajv": "8.17.1",
    "axios": "1.9.0",
    "chart.js": "4.4.8",
    "crypto-js": "4.2.0",
    "date-fns": "4.1.0",
    "dompurify": "3.2.6",
    "framer-motion": "12.23.12",
    "katex": "0.16.21",
    "mathjax-react": "2.0.1",
    "otpauth": "9.4.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-chartjs-2": "5.3.0",
    "react-dom": "18.3.1",
    "react-error-boundary": "5.0.0",
    "react-helmet-async": "2.0.5",
    "react-intersection-observer": "9.16.0",
    "react-katex": "3.0.1",
    "react-router-dom": "7.6.2",
    "react-virtualized-auto-sizer": "1.0.24",
    "react-window": "1.8.11",
    "recharts": "2.15.3",
    "socket.io-client": "4.8.1",
    "uuid": "11.1.0",
    "validator": "13.15.15"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@playwright/test": "1.52.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.21",
    "@types/react": "18.3.21",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.4.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "4.8.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.1.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
