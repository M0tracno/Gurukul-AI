# ===========================================================================
# GURUKUL AI BACKEND — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ---------------------------------------------------------------------------

# ─── Server Configuration ───────────────────────────────────────────────────────
# Environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Frontend URL (used for CORS origin allowlist)
FRONTEND_URL=http://localhost:5173

# Additional CORS origins (comma-separated, optional)
# ADDITIONAL_CORS_ORIGINS=http://localhost:3000,https://staging.example.com

# ─── MongoDB Configuration ──────────────────────────────────────────────────────
# Connection URI — get yours from https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/gurukul?retryWrites=true&w=majority

# Connection pool sizing (min 2, max 50)
MONGO_MIN_POOL=2
MONGO_MAX_POOL=10

# ─── Redis Configuration ────────────────────────────────────────────────────────
# Used by BullMQ job queues and caching.
# REDIS_URL takes precedence over individual host/port/password settings.
# Format: redis://[username:password@]host:port[/database]
# REDIS_URL=redis://localhost:6379

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ─── JWT Authentication ─────────────────────────────────────────────────────────
# Secret key for signing access and refresh tokens.
# Generate a secure secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-64-byte-hex-secret-minimum-32-characters

# Token expiry (access: short-lived, refresh: long-lived)
# These are used by authTokenService (access=15m, refresh=7d by design).
# The legacy JWT_EXPIRES_IN is kept for backward compat with older code paths.
JWT_EXPIRES_IN=7d

# ─── Google Gemini AI ───────────────────────────────────────────────────────────
# API key for AI grading pipeline (Google Generative AI)
# Get yours from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── Google Cloud Services ──────────────────────────────────────────────────────
# Cloud Vision API key (OCR for paper grading)
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key

# External API health check URL (used by /health endpoint)
EXTERNAL_API_HEALTH_URL=https://generativelanguage.googleapis.com

# ─── Email / SMTP Configuration ────────────────────────────────────────────────
# Used for account lockout notifications and password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Sender address for system emails
EMAIL_FROM=noreply@gdc-system.com

# ─── SMS Service (MSG91) ───────────────────────────────────────────────────────
# Used for parent OTP login
MSG91_API_KEY=your-msg91-api-key
MSG91_SENDER_ID=GURKUL
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id

# ─── Error Reporting (Sentry) ──────────────────────────────────────────────────
# Backend Sentry DSN for server-side error tracking
# Get from: https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ─── Performance Monitoring ────────────────────────────────────────────────────
# Threshold (ms) before a slow response triggers an alert (default: 2000)
PERF_ALERT_THRESHOLD_MS=2000

# Notification channel for performance alerts: log | email | webhook
ADMIN_NOTIFICATION_CHANNEL=log

# Set to "false" to disable performance alerting
PERF_ALERTING_ENABLED=true

# ─── Logging Configuration ─────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Directory for log file storage (default: ./logs)
LOG_DIR=./logs

# Number of days to retain log files (default: 30)
LOG_RETENTION_DAYS=30

# Maximum size per log file before rotation (e.g., '20m', '100m')
LOG_MAX_FILE_SIZE=20m

# Whether to gzip rotated log files (default: true)
LOG_COMPRESS=true
