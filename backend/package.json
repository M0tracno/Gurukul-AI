{
  "name": "gurukul-ai-backend",
  "version": "2.0.0",
  "description": "Gurukul AI Backend — MongoDB + Express + TypeScript",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pre-deploy": "node scripts/pre-deploy.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:pbt": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=property"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "bullmq": "5.52.1",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "express-validator": "7.3.2",
    "helmet": "8.2.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.6.3",
    "morgan": "1.11.0",
    "multer": "2.1.1",
    "nodemailer": "8.0.10",
    "socket.io": "4.8.3",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.1",
    "@types/nodemailer": "8.0.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "fast-check": "4.8.0",
    "jest": "30.4.2",
    "mongodb-memory-server": "11.2.0",
    "nodemon": "3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
