# ============================================
# Docker Compose Environment Variables
# ============================================
# Copy this to .env in the root directory for Docker Compose to pick up,
# or pass values directly when running docker compose.
#
# Usage: docker compose --env-file .env.docker up

# MongoDB Configuration
MONGO_ROOT_USERNAME=gurukul
MONGO_ROOT_PASSWORD=gurukul_dev
MONGO_DB_NAME=gurukul_ai

# Redis Configuration (no password for local dev)
REDIS_HOST=redis
REDIS_PORT=6379
